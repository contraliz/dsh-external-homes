{
  "name": "dsh-external-homes",
  "version": "0.3.0",
  "description": "Browse sessions from other DSH homes and open them as normal DSH conversations",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contraliz/dsh-external-homes.git"
  },
  "homepage": "https://github.com/contraliz/dsh-external-homes#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sessions",
    "history"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.0-0 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0",
    "@deepseek-ai/dsh-session": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-session-persistence-jsonl": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.0-0 <4.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
